{
  "name": "obsidian-focus-flow",
  "version": "0.1.0",
  "description": "A Markdown-native personal work-management workflow for Obsidian.",
  "type": "module",
  "main": "main.js",
  "bin": {
    "focus-flow": "dist/focus-flow.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint src",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:performance": "vitest run --project performance",
    "test:e2e:run": "wdio run ./wdio.conf.mts",
    "test:e2e": "pnpm build && pnpm test:e2e:run",
    "test:e2e:mobile": "pnpm build && OBSIDIAN_E2E_PROFILE=mobile pnpm test:e2e:run",
    "test:e2e:headless": "node scripts/run-e2e-headless.mjs",
    "test:e2e:mobile:headless": "node scripts/run-e2e-headless.mjs --mobile",
    "test:release-helper": "python3 -m unittest discover -s .github/scripts/tests -t .github/scripts",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "build": "pnpm typecheck && node esbuild.config.mjs production",
    "build:cli": "node esbuild.cli.config.mjs",
    "quality:architecture": "depcruise src --output-type err-long",
    "quality:dead-code": "knip --no-exit-code --no-config-hints",
    "quality": "pnpm quality:architecture && pnpm quality:dead-code",
    "verify:release": "node scripts/verify-release.mjs",
    "package:release": "pnpm verify:release && node scripts/package-release.mjs",
    "check": "pnpm lint && pnpm quality && pnpm typecheck && pnpm test:unit && pnpm test:performance && pnpm test:storybook && pnpm build:storybook && pnpm build && pnpm build:cli && pnpm verify:release",
    "check:full": "pnpm lint && pnpm quality && pnpm typecheck && pnpm test:unit && pnpm test:performance && pnpm test:e2e && pnpm test:storybook && pnpm build:storybook && pnpm build:cli && pnpm verify:release",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "kanban",
    "personal-productivity"
  ],
  "license": "MIT",
  "dependencies": {
    "@dnd-kit/react": "^0.5.0",
    "fractional-indexing": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.2",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.17",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@wdio/cli": "^9.31.7",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.7",
    "@wdio/mocha-framework": "^9.31.7",
    "dependency-cruiser": "^18.2.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.12.0",
    "jiti": "^2.6.1",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "mocha": "^10.8.2",
    "obsidian": "^1.13.1",
    "playwright": "^1.62.1",
    "storybook": "^10.6.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wdio-obsidian-reporter": "^3.2.0",
    "wdio-obsidian-service": "^3.2.0"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
